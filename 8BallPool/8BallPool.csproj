<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required by the source-generated P/Invoke stubs ([LibraryImport]). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>EightBallPool</RootNamespace>
    <AssemblyName>8BallPool</AssemblyName>
    <ApplicationIcon>favicon.ico</ApplicationIcon>

    <!-- Consumed by ApplicationConfiguration.Initialize() in Program.cs -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>

    <!-- Version is overridden by CI with -p:Version=... -->
    <Version>2.0.0.0</Version>
    <Product>8 Ball Pool Guideline</Product>
    <Description>Overlay that draws aiming guidelines from a reference ball to every pocket.</Description>
    <Copyright>Copyright © 2016-2026 Elisson Silva</Copyright>
  </PropertyGroup>

</Project>
